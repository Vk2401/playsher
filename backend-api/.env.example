# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
 
# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=playsher_db
DB_USER=root
DB_PASSWORD=root
# Remote/managed MySQL usually needs TLS; set true on Hostinger Remote MySQL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Shared hosting caps total connections — use 2 when deploying to serverless.
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_512_bit_jwt_secret_here_replace_with_strong_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
ADMIN_SECRET=change_me

# ── CORS (comma-separated origins) ────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Timezone ──────────────────────────────────────────────────────────────────
# Slot times are stored as venue wall-clock strings, so the API must know which
# zone they mean. Deploy hosts run UTC; leaving this unset would offer slots
# that have already been played. Change only if Playsher launches outside India.
APP_TIMEZONE=Asia/Kolkata

# ── OTP ───────────────────────────────────────────────────────────────────────
# Development only: accept ANY 6-digit OTP for a valid Indian mobile number.
# The number is still validated (10 digits, starting 6-9). NEVER true in production.
OTP_DEV_BYPASS=false

# ── Uploads ───────────────────────────────────────────────────────────────────
# local = write to ./uploads (needs a persistent disk)
# ftp   = push to a remote host, required on serverless
UPLOAD_DRIVER=local
# Public base for stored images. Leave blank for local dev (paths stay relative).
UPLOAD_PUBLIC_URL=
UPLOAD_FTP_HOST=
UPLOAD_FTP_PORT=21
UPLOAD_FTP_USER=
UPLOAD_FTP_PASSWORD=
UPLOAD_FTP_SECURE=false
UPLOAD_FTP_BASE_DIR=/public_html

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── Payouts (Razorpay Route) ─────────────────────────────────────────────────
# Fallback commission rate as a fraction: 0.10 is 10%.
#
# The live rate is normally set by a super admin in the panel (Settlements ->
# Platform commission) and stored in platform_settings. This is only the
# fallback for a database with no rate set yet. Unset or blank falls back to
# 10% rather than charging nothing.
#
# Whichever source wins, the rate that applied to a payment is frozen onto
# that payment, so changing it never restates past earnings.
PLATFORM_COMMISSION_RATE=0.10

# Route uses the same keys as checkout. Without them a payment is still captured
# and the split is still recorded, but the owner transfer is deferred.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret from the Razorpay dashboard (Settings -> Webhooks).
# Different from the API secret. Without it the webhook endpoint refuses every
# call rather than trusting an unsigned one, so payout statuses stop updating.
RAZORPAY_WEBHOOK_SECRET=
