# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
 
# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=playsher_db
DB_USER=root
DB_PASSWORD=root
# Remote/managed MySQL usually needs TLS; set true on Hostinger Remote MySQL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Shared hosting caps total connections — use 2 when deploying to serverless.
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_512_bit_jwt_secret_here_replace_with_strong_random_string_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
ADMIN_SECRET=change_me

# ── CORS (comma-separated origins) ────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── OTP ───────────────────────────────────────────────────────────────────────
# Development only: accept ANY 6-digit OTP for a valid Indian mobile number.
# The number is still validated (10 digits, starting 6-9). NEVER true in production.
OTP_DEV_BYPASS=false

# ── Uploads ───────────────────────────────────────────────────────────────────
# local = write to ./uploads (needs a persistent disk)
# ftp   = push to a remote host, required on serverless
UPLOAD_DRIVER=local
# Public base for stored images. Leave blank for local dev (paths stay relative).
UPLOAD_PUBLIC_URL=
UPLOAD_FTP_HOST=
UPLOAD_FTP_PORT=21
UPLOAD_FTP_USER=
UPLOAD_FTP_PASSWORD=
UPLOAD_FTP_SECURE=false
UPLOAD_FTP_BASE_DIR=/public_html

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
